#!/usr/bin/env bash

set -euo pipefail

# Minimal user data: prepare EC2 for Ansible provisioning
echo "=== Preparing EC2 for Ansible ==="

# Update system packages
apt-get update
apt-get upgrade -y

# Install Python (required for Ansible)
apt-get install -y python3 python3-pip

# Install basic tools
apt-get install -y curl wget vim net-tools

# Ensure SSH is ready
systemctl restart ssh

echo "=== EC2 is ready for Ansible provisioning ===" 