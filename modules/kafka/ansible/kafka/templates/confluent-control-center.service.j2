[Unit]
Description=Confluent Control Center
After=network.target confluent-kafka.service confluent-schema-registry.service confluent-kafka-connect.service
Wants=confluent-kafka.service

[Service]
Type=simple
User=confluent
WorkingDirectory=/opt/confluent
Environment="CONTROL_CENTER_HEAP_OPTS=-Xms512M -Xmx1024M"
ExecStart=/opt/confluent/bin/control-center-start /opt/confluent/etc/confluent-control-center/control-center.properties
ExecStop=/bin/true
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
